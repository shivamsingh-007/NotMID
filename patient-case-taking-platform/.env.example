# Local development only. Never reuse these placeholder credentials outside a
# developer machine; production values must come from a secrets manager.
# Infrastructure
POSTGRES_DB=notmid
POSTGRES_USER=notmid
POSTGRES_PASSWORD=notmid-local-only
MINIO_ROOT_USER=notmid-local
MINIO_ROOT_PASSWORD=notmid-local-only-change-me
MINIO_CONSOLE_PORT=9002

# Application
APP_ENV=development
DATABASE_URL=postgresql://notmid:notmid-local-only@localhost:5432/notmid
DATABASE_MAINTENANCE_URL=
MONGODB_URL=mongodb://localhost:27017
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:9092
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_SERVER_SIDE_ENCRYPTION=
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
ENABLE_DEMO_ROUTES=false
DOCUMENT_WORKFLOW_ENABLED=false
DOCUMENT_UPLOAD_GRANT_TTL_SECONDS=300
DOCUMENT_PREVIEW_GRANT_TTL_SECONDS=300
DOCUMENT_UPLOAD_SESSION_TTL_SECONDS=900
DOCUMENT_UPLOAD_CLEANUP_INTERVAL_SECONDS=60
DOCUMENT_UPLOAD_CLEANUP_BATCH_SIZE=100
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=30
DOCUMENT_SCAN_MAX_BYTES=10485760
DOCUMENT_SCAN_BATCH_SIZE=10
DOCUMENT_SCAN_POLL_INTERVAL_SECONDS=2
DOCUMENT_NORMALIZATION_MAX_PAGES=20
DOCUMENT_NORMALIZATION_MAX_PIXELS_PER_PAGE=25000000
DOCUMENT_NORMALIZATION_MAX_TOTAL_PIXELS=100000000
DOCUMENT_NORMALIZATION_RENDER_DPI=200
DOCUMENT_NORMALIZATION_TIMEOUT_SECONDS=30
DOCUMENT_NORMALIZATION_BATCH_SIZE=2
DOCUMENT_NORMALIZATION_POLL_INTERVAL_SECONDS=2
OCR_PROVIDER=mock
OCR_LANGUAGE=en
OCR_ALLOW_COMPLEX_LAYOUT_PROVIDER=false
OCR_ARTIFACT_DATABASE=notmid
OCR_ARTIFACT_COLLECTION=document_ocr_artifacts
EXTRACTION_DRAFT_COLLECTION=document_extraction_drafts
DOCUMENT_OCR_TIMEOUT_SECONDS=60
DOCUMENT_OCR_MAX_PAGE_BYTES=52428800
DOCUMENT_OCR_LEASE_SECONDS=120
DOCUMENT_OCR_MAX_ATTEMPTS=3
DOCUMENT_OCR_BATCH_SIZE=2
DOCUMENT_OCR_POLL_INTERVAL_SECONDS=2
DOCUMENT_OCR_AUTOMATION_ENABLED=true
DOCUMENT_EXTRACTION_LEASE_SECONDS=60
DOCUMENT_EXTRACTION_MAX_ATTEMPTS=3
DOCUMENT_EXTRACTION_BATCH_SIZE=2
DOCUMENT_EXTRACTION_POLL_INTERVAL_SECONDS=2
DOCUMENT_EXTRACTION_AUTOMATION_ENABLED=true
DOCUMENT_PROMOTION_BATCH_SIZE=10
DOCUMENT_PROMOTION_POLL_INTERVAL_SECONDS=2
DOCUMENT_OUTBOX_LEASE_SECONDS=30
DOCUMENT_OUTBOX_MAX_ATTEMPTS=3
DOCUMENT_OUTBOX_BATCH_SIZE=25
DOCUMENT_OUTBOX_POLL_INTERVAL_SECONDS=1
DOCUMENT_EVENT_TOPIC=clinical.documents.v1
READINESS_TIMEOUT_SECONDS=1.5
LLM_PROVIDER=mock
SUMMARY_WORKFLOW_ENABLED=false
SUMMARY_OUTBOX_LEASE_SECONDS=30
SUMMARY_OUTBOX_MAX_ATTEMPTS=3
SUMMARY_OUTBOX_BATCH_SIZE=25
SUMMARY_OUTBOX_POLL_INTERVAL_SECONDS=1
SUMMARY_EVENT_TOPIC=clinical.summaries.v1

# Auth
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
